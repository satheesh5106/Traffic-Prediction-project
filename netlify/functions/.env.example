# TrafficAI Netlify Functions Environment Variables

# HERE Traffic API Configuration
HERE_APP_ID=your_here_app_id
HERE_APP_CODE=your_here_app_code
HERE_API_KEY=your_here_api_key

# OpenRouteService API
OPENROUTE_API_KEY=your_openroute_api_key

# OneSignal Push Notifications
ONESIGNAL_APP_ID=your_onesignal_app_id
ONESIGNAL_API_KEY=your_onesignal_api_key

# SMS Provider (Twilio example)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=your_twilio_phone_number

# Email Provider (SendGrid example)
SENDGRID_API_KEY=your_sendgrid_api_key
SENDGRID_FROM_EMAIL=alerts@trafficai.com

# Application Configuration
APP_URL=https://verifyai1.netlify.app
API_VERSION=1.0.0
ENVIRONMENT=production

# Rate Limiting
RATE_LIMIT_REQUESTS=1000
RATE_LIMIT_WINDOW=3600

# Cache Configuration
CACHE_TTL_TRAFFIC=300
CACHE_TTL_ROUTES=600
CACHE_TTL_ALERTS=60

# Model Configuration
MODEL_ACCURACY_THRESHOLD=85
TRAFFIC_UPDATE_INTERVAL=300
ALERT_COOLDOWN_PERIOD=1800

# Geographic Bounds (India)
DEFAULT_LATITUDE=20.5937
DEFAULT_LONGITUDE=78.9629
MAX_ROUTE_DISTANCE=1000

# Monitoring
LOG_LEVEL=info
ENABLE_METRICS=true
METRICS_ENDPOINT=/metrics