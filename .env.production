# TrafficAI Production Environment Variables
# Copy this file and replace with your actual values

# Firebase Configuration
# Get these from Firebase Console > Project Settings > Service Accounts
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour Firebase Private Key Here\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com

# HERE Maps API Configuration
# Get from HERE Developer Portal: https://developer.here.com/
HERE_API_KEY=your-here-maps-api-key

# OpenRouteService Configuration
# Get from OpenRouteService: https://openrouteservice.org/dev/#/signup
ORS_API_KEY=your-openrouteservice-api-key

# OneSignal Push Notifications
# Get from OneSignal Dashboard: https://onesignal.com/
ONESIGNAL_APP_ID=your-onesignal-app-id
ONESIGNAL_REST_API_KEY=your-onesignal-rest-api-key

# Open-Meteo Weather API (Free, no key required)
OPEN_METEO_API_URL=https://api.open-meteo.com/v1

# Node.js Environment
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1

# Netlify Functions Configuration
NETLIFY_FUNCTIONS_URL=https://your-site.netlify.app/.netlify/functions

# Security Configuration
JWT_SECRET=your-jwt-secret-key-for-additional-security
API_RATE_LIMIT=100
API_RATE_WINDOW=900000

# Database Configuration (if using external database)
# DATABASE_URL=your-database-connection-string
# REDIS_URL=your-redis-connection-string

# Monitoring and Analytics
# SENTRY_DSN=your-sentry-dsn-for-error-tracking
# GOOGLE_ANALYTICS_ID=your-google-analytics-id

# Feature Flags
ENABLE_CACHING=true
ENABLE_RATE_LIMITING=true
ENABLE_AUDIT_LOGGING=true
ENABLE_PERFORMANCE_MONITORING=true

# API Endpoints Configuration
TRAFFIC_PREDICTION_CACHE_TTL=300
ROUTE_OPTIMIZATION_CACHE_TTL=600
WEATHER_DATA_CACHE_TTL=1800
ANALYTICS_CACHE_TTL=3600

# Geographic Configuration
DEFAULT_COUNTRY=IN
DEFAULT_TIMEZONE=Asia/Kolkata
DEFAULT_LANGUAGE=en

# Performance Configuration
MAX_CONCURRENT_REQUESTS=50
REQUEST_TIMEOUT=30000
MAX_PAYLOAD_SIZE=10485760

# Logging Configuration
LOG_LEVEL=info
LOG_FORMAT=json
ENABLE_REQUEST_LOGGING=true
ENABLE_ERROR_LOGGING=true

# CORS Configuration
ALLOWED_ORIGINS=https://your-frontend-domain.com,https://your-app-domain.com
ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
ALLOWED_HEADERS=Content-Type,Authorization,X-Requested-With

# Health Check Configuration
HEALTH_CHECK_INTERVAL=60000
HEALTH_CHECK_TIMEOUT=5000

# Backup and Recovery
# BACKUP_STORAGE_URL=your-backup-storage-url
# BACKUP_FREQUENCY=daily
# BACKUP_RETENTION_DAYS=30