# TomTom API Configuration
TOMTOM_API_KEY=LPnygt3dMhUJGpHMLIMDJM92a25JMALE
NEXT_PUBLIC_TOMTOM_API_KEY=LPnygt3dMhUJGpHMLIMDJM92a25JMALE

# Python ML Service
PYTHON_ML_URL=http://localhost:5000

# Database Configuration
DATABASE_URL="file:./dev.db"

# Redis Configuration (Optional)
REDIS_URL=redis://localhost:6379
REDIS_ENABLED=false

# Security Configuration
HELMET_ENABLED=true
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging Configuration
LOG_LEVEL=info
LOG_FILE_ENABLED=true

# Cache Configuration
CACHE_TTL=300
SPATIAL_CACHE_ENABLED=true

# External APIs
IMD_BASE_URL=https://mausam.imd.gov.in
IPAPI_URL=http://ip-api.com/json

# ML Model Configuration
ML_ACCURACY_THRESHOLD=0.93
TRAFFIC_PREDICTION_ACCURACY=0.95
INCIDENT_PREDICTION_ACCURACY=0.93

# Prometheus Metrics
METRICS_ENABLED=true
METRICS_PORT=9090

# CORS Configuration
CORS_ORIGIN_DEV=http://localhost:3001,http://localhost:3000
CORS_ORIGIN_PROD=https://trafficai.netlify.app

# File Upload Configuration
MAX_FILE_SIZE=10mb
UPLOAD_DIR=./uploads

# Dataset Configuration
DATASET_DIR=./Backend/datasets
METR_LA_DATASET=./Backend/datasets/METR-LA.csv
UK_ACCIDENTS_DATASET=./Backend/datasets/Accident_Information.csv
INDIA_ACCIDENTS_DATASET=./Backend/datasets/road_accident_severity_india.csv

# Performance Configuration
MAX_RETRIES=3
RETRY_DELAY=1000
REQUEST_TIMEOUT=30000

# Feature Flags
ENABLE_REAL_TIME_UPDATES=true
ENABLE_ML_PREDICTIONS=true
ENABLE_CACHING=true
ENABLE_METRICS=true

# Development Configuration
DEBUG_MODE=true
VERBOSE_LOGGING=true