{
  "name": "nextjs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "server": "node src/server.js",
    "server:dev": "nodemon src/server.js",
    "server:build": "tsc -p tsconfig.server.json",
    "dev:full": "concurrently \"npm run dev\" \"npm run server:dev\"",
    "build:full": "npm run build && npm run server:build",
    "start:full": "concurrently \"npm run start\" \"npm run server\"",
    "lint": "next lint",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:api": "jest --testPathPattern=tests/api-tests.js",
    "test:routes": "jest --testPathPattern=tests/route-tests.js",
    "deploy": "./deploy.sh",
    "deploy:quick": "./deploy.sh --skip-local-test",
    "deploy:test": "node test-deployment.js",
    "netlify:dev": "netlify dev",
    "netlify:build": "netlify build",
    "netlify:deploy": "netlify deploy",
    "netlify:deploy:prod": "netlify deploy --prod",
    "functions:test": "node test-deployment.js",
    "env:check": "node -e \"console.log('Environment check:', process.env.NODE_ENV)\"",
    "postbuild": "echo 'Build completed successfully'",
    "predeploy": "npm run test:api && npm run build"
  },
  "dependencies": {
    "@ant-design/icons": "^6.0.0",
    "@hookform/resolvers": "^3.9.0",
    "@next/swc-wasm-nodejs": "13.5.1",
    "@radix-ui/react-accordion": "^1.2.0",
    "@radix-ui/react-alert-dialog": "^1.1.1",
    "@radix-ui/react-aspect-ratio": "^1.1.0",
    "@radix-ui/react-avatar": "^1.1.0",
    "@radix-ui/react-checkbox": "^1.1.1",
    "@radix-ui/react-collapsible": "^1.1.0",
    "@radix-ui/react-context-menu": "^2.2.1",
    "@radix-ui/react-dialog": "^1.1.1",
    "@radix-ui/react-dropdown-menu": "^2.1.1",
    "@radix-ui/react-hover-card": "^1.1.1",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-menubar": "^1.1.1",
    "@radix-ui/react-navigation-menu": "^1.2.0",
    "@radix-ui/react-popover": "^1.1.1",
    "@radix-ui/react-progress": "^1.1.0",
    "@radix-ui/react-radio-group": "^1.2.0",
    "@radix-ui/react-scroll-area": "^1.1.0",
    "@radix-ui/react-select": "^2.1.1",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-slider": "^1.2.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-switch": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.0",
    "@radix-ui/react-toast": "^1.2.1",
    "@radix-ui/react-toggle": "^1.1.0",
    "@radix-ui/react-toggle-group": "^1.1.0",
    "@radix-ui/react-tooltip": "^1.1.2",
    "@react-three/drei": "^9.88.13",
    "@react-three/fiber": "^8.15.19",
    "@turf/turf": "^6.5.0",
    "@types/gsap": "^1.20.2",
    "@types/node": "20.6.2",
    "@types/react": "18.2.22",
    "@types/react-dom": "18.2.7",
    "antd": "^5.27.1",
    "autoprefixer": "10.4.15",
    "axios": "^1.11.0",
    "body-parser": "^1.20.2",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "cmdk": "^1.0.0",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "date-fns": "^3.6.0",
    "dotenv": "^17.2.1",
    "embla-carousel-react": "^8.3.0",
    "eslint": "8.49.0",
    "eslint-config-next": "13.5.1",
    "express": "^4.18.2",
    "firebase": "^12.1.0",
    "firebase-admin": "^13.4.0",
    "framer-motion": "^12.23.12",
    "gsap": "^3.13.0",
    "helmet": "^7.2.0",
    "input-otp": "^1.2.4",
    "js-cookie": "^3.0.5",
    "leaflet": "^1.9.4",
    "lottie-react": "^2.4.1",
    "lucide-react": "^0.446.0",
    "maplibre-gl": "^5.7.0",
    "morgan": "^1.10.1",
    "next": "13.5.1",
    "next-themes": "^0.3.0",
    "nodejs-polars": "^0.21.0",
    "onesignal-node": "^3.4.0",
    "postcss": "8.4.30",
    "react": "18.2.0",
    "react-day-picker": "^8.10.1",
    "react-dom": "18.2.0",
    "react-firebase-hooks": "^5.1.1",
    "react-hook-form": "^7.53.0",
    "react-map-gl": "^8.0.4",
    "react-resizable-panels": "^2.1.3",
    "recharts": "^2.12.7",

    "sonner": "^1.5.0",
    "tailwind-merge": "^2.5.2",
    "tailwindcss": "3.3.3",
    "tailwindcss-animate": "^1.0.7",
    "three": "^0.179.1",
    "three-stdlib": "^2.36.0",
    "typescript": "5.2.2",
    "uuid": "^9.0.1",
    "vaul": "^0.9.9",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/js-cookie": "^3.0.6",
    "@types/morgan": "^1.9.9",
    "@types/supertest": "^6.0.2",
    "@types/three": "^0.169.0",
    "@types/uuid": "^9.0.7",
    "concurrently": "^8.2.2",
    "jest": "^29.7.0",
    "jest-environment-node": "^29.7.0",
    "nodemon": "^3.0.1",
    "pino-pretty": "^13.1.1",
    "supertest": "^6.3.3",
    "ts-node": "^10.9.2"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "netlify/functions/**/*.js",
      "!netlify/functions/**/*.test.js",
      "!netlify/functions/node_modules/**"
    ],
    "coverageDirectory": "netlify/functions/coverage",
    "coverageReporters": [
      "text",
      "lcov",
      "html"
    ],
    "testMatch": [
      "**/tests/**/*.js",
      "**/__tests__/**/*.js",
      "**/*.test.js"
    ],
    "setupFilesAfterEnv": [],
    "testTimeout": 30000,
    "modulePathIgnorePatterns": [
      "<rootDir>/Installations/",
      "<rootDir>/.next/"
    ],
    "testPathIgnorePatterns": [
      "<rootDir>/Installations/",
      "<rootDir>/.next/"
    ]
  }
}
