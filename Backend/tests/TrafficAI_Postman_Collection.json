    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Auto-extract auth token from login response",
          "if (pm.info.requestName === \"Login User\" && pm.response.code === 200) {",
          "    const responseJson = pm.response.json();",
          "    if (responseJson.success && responseJson.data && responseJson.data.token) {",
          "        pm.environment.set(\"authToken\", responseJson.data.token);",
          "        console.log(\"Auth token saved to environment\");",
          "    }",
          "}"
        ]
      }
    }
